extends ../../layout

block content
    h2(style="color: #1f2937; margin-bottom: 12px;") 📋 ¡Nuevo registro en #{gymName || 'tu gimnasio'}!
    
    p.message(style="font-size: 16px; color: #374151; line-height: 1.6; margin-bottom: 20px;")
        | Estimado/a #[strong #{adminName || 'Administrador'}], te informamos que un nuevo #[strong #{roleName || 'cliente'}] ha completado su registro en #[strong #{gymName || 'el gimnasio'}].

    div(style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; margin: 25px 0;")
        h3(style="color: #111827; font-size: 16px; margin-top: 0; margin-bottom: 15px; border-bottom: 1px solid #e5e7eb; padding-bottom: 10px;") Datos del usuario registrado
        table(cellpadding="0" cellspacing="0" width="100%" style="font-size: 14px; color: #4b5563; line-height: 2;")
            if userName
                tr
                    td(width="42%" style="font-weight: 600; color: #374151;") Nombre completo:
                    td(width="58%")= userName
            if document
                tr
                    td(style="font-weight: 600; color: #374151;") Cédula / Documento:
                    td= document
            if userEmail
                tr
                    td(style="font-weight: 600; color: #374151;") Correo electrónico:
                    td= userEmail
            if userPhone && userPhone !== '-'
                tr
                    td(style="font-weight: 600; color: #374151;") Teléfono:
                    td= userPhone
            if emergencyPhone && emergencyPhone !== '-'
                tr
                    td(style="font-weight: 600; color: #374151;") Teléfono de emergencia:
                    td= emergencyPhone
            if roleName
                tr
                    td(style="font-weight: 600; color: #374151;") Rol / Categoría:
                    td= roleName
            if registrationDate
                tr
                    td(style="font-weight: 600; color: #374151;") Fecha de registro:
                    td= registrationDate

    if dashboardUrl
        div(style="text-align: center; margin: 30px 0 20px 0;")
            a(href=dashboardUrl target="_blank" style="display: inline-block; background-color: #059669; color: #ffffff; text-decoration: none; padding: 12px 28px; border-radius: 8px; font-weight: 600; font-size: 15px; box-shadow: 0 2px 4px rgba(5, 150, 105, 0.2);") Ver en el Panel de Administración

    p.info(style="font-size: 13px; color: #6b7280; margin-top: 25px; border-top: 1px solid #f3f4f6; padding-top: 15px;")
        | Esta es una notificación automática generada por el sistema de gestión de #{gymName || 'tu gimnasio'}.

